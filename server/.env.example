# Copy to .env and fill in. NEVER commit the real .env file.

PORT=5000
# Screening history is stored in a JSON file (no database needed).
# Optional: change the location. Default: server/data/screenings.json
# DATA_FILE=./data/screenings.json

# ---- CO4: language model. LLM_PROVIDER = slm | anthropic | fallback
LLM_PROVIDER=slm

# Small language model served by Ollama (see docs/SLM.md)
SLM_URL=http://localhost:11434
SLM_MODEL=qwen2.5:3b
SLM_API_KEY=
SLM_TIMEOUT_MS=180000

# Optional: hosted LLM instead (Anthropic Messages API)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- CO3: AWS multilingual services (Comprehend + Translate). Set to true to enable.
USE_AWS=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
